# ==============================================================================
# FPL Oracle Environment Configuration
# ==============================================================================

# LLM Providers (At least one recommended for full AI chat; tool operates fully offline/rule-based without keys)
# Get a free Gemini key at: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=
# Optional alternative LLM providers:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Default Profile
# Find your Manager ID in your FPL URL: https://fantasy.premierleague.com/entry/{ID}/event/1
FPL_MANAGER_ID=
# Find your Mini-League ID in your League URL: https://fantasy.premierleague.com/leagues/{ID}/standings/c
FPL_TARGET_LEAGUE_ID=

# Search APIs (Optional - for extended live press conference web search)
TAVILY_API_KEY=
BRAVE_API_KEY=

# Betting Odds (Optional - if provided, betting implied odds enhance goal models)
ODDS_API_KEY=

# Deadline & Alert Webhooks (Optional)
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
