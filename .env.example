# ==============================================================================
# FPL Oracle — Environment Configuration (.env.example)
# All user IDs, secrets, and runtime settings live exclusively in project-local .env
# Copy this file to .env:  cp .env.example .env
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Official Fantasy Premier League User Settings (Loaded Server-Side Only)
# ------------------------------------------------------------------------------
# Your personal 6-8 digit FPL Entry/Manager ID.
# Find it in your official team URL: https://fantasy.premierleague.com/entry/{ID}/event/1
# Required for live squad sync, selling prices, and banked free transfer math.
FPL_MANAGER_ID=

# Your target classic mini-league ID for rival analysis and Monte Carlo simulation.
# Find it in your mini-league URL: https://fantasy.premierleague.com/leagues/{ID}/standings/c
# Optional (Defaults to public benchmarks if blank).
FPL_TARGET_LEAGUE_ID=

# ------------------------------------------------------------------------------
# 2. Google Gemini Free-Tier Evidence Extractor (100% Free / Non-Billable Tier)
# ------------------------------------------------------------------------------
# Obtain your free API key at Google AI Studio: https://aistudio.google.com/app/apikey
# Must be created in a Google Cloud project with billing NOT enabled.
GEMINI_API_KEY=

# Safeguard confirmation: Set to true only after verifying your project is non-billable Free Tier.
# The extractor will fail-closed and gracefully use official API data if this is false.
GEMINI_FREE_TIER_CONFIRMED=false

# Verified free model default. Do not change unless testing a specific free preview model.
# Safe Default: gemini-2.5-flash-lite
GEMINI_MODEL=gemini-2.5-flash-lite

# Bounded rate and token limits to strictly enforce free tier compliance.
GEMINI_DAILY_REQUEST_BUDGET=150
GEMINI_DAILY_TOKEN_BUDGET=500000

# ------------------------------------------------------------------------------
# 3. Recommendation Application Mode & Gated Activation
# ------------------------------------------------------------------------------
# Application mode for candidate news evidence extractions:
# - 'shadow' (Default & Recommended): Candidate projections are computed and logged
#   in shadow mode for evaluation, but NEVER applied to production suggestions.
# - 'api_only': Disables text extraction; uses official Premier League API baseline only.
# - 'gated_active': Applies validated candidate overrides to production suggestions
#   (Requires passing the adversarial offline evaluation gate and setting GATED_ACTIVE_OPT_IN=true).
NEWS_RECOMMENDATION_MODE=shadow

# Explicit opt-in for gated-active mode. Must be set to true only when NEWS_RECOMMENDATION_MODE=gated_active.
GATED_ACTIVE_OPT_IN=false

# ------------------------------------------------------------------------------
# 4. Optional External Providers (The app runs 100% free without any of these)
# ------------------------------------------------------------------------------
# Optional provider for conversational intelligence chat: "gemini", "anthropic", or "openai"
LLM_PROVIDER=gemini

# Optional alternative API keys (only needed if LLM_PROVIDER is changed from gemini):
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional search API keys for press conference discovery (Not required):
TAVILY_API_KEY=
BRAVE_API_KEY=

# Optional free betting odds key from https://the-odds-api.com/ (Not required):
# The engine uses continuous team ratings by default.
ODDS_API_KEY=

# Optional notification webhooks for pre-deadline alerts:
DISCORD_WEBHOOK_URL=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
